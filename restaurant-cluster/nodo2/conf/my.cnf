[mysqld]
# Identificación del Nodo 2 (Cocina / Stock)
server-id = 2
bind-address = 0.0.0.0

# Motor transaccional y codificación
default-storage-engine = InnoDB
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Prevención de colisiones Multi-Primary Simétrico (Nodos Pares: 2, 4, 6...)
auto_increment_increment = 2
auto_increment_offset = 2

# Configuración de Binary Log y GTID para Replicación Simétrica
log-bin = mysql-bin
binlog_format = ROW
log_slave_updates = ON
gtid_mode = ON
enforce_gtid_consistency = ON

# Consistencia y Persistencia Transaccional (ACID estricto)
innodb_flush_log_at_trx_commit = 1
sync_binlog = 1

# Replicación Semisincrónica (2PC Conceptual - AFTER_SYNC)
plugin-load-add = semisync_master.so
plugin-load-add = semisync_slave.so
loose_rpl_semi_sync_master_enabled = 1
loose_rpl_semi_sync_slave_enabled = 1
loose_rpl_semi_sync_master_wait_point = AFTER_SYNC
loose_rpl_semi_sync_master_timeout = 3000
